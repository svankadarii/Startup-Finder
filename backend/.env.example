# Copy this file to .env and fill in your keys

# Required — get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables Product Hunt scraping
# Get a token at https://www.producthunt.com/v2/oauth/applications
PH_API_TOKEN=

# Optional — enables Crunchbase scraping
# Get a key at https://data.crunchbase.com/docs/using-the-api
CRUNCHBASE_API_KEY=
